# ============================================================
# MedKyrgyz AI — backend configuration
# Copy this file to `.env` and fill in real values.
# Never commit `.env` to git.
# ============================================================

# ---- Application ----
APP_NAME=MedKyrgyz AI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ---- CORS: comma-separated list of allowed frontend origins ----
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# ---- Database (path is relative to the project root) ----
DATABASE_URL=sqlite:///database/medkyrgyz.db

# ---- LLM ----
# auto   -> use OpenAI if OPENAI_API_KEY is set, otherwise the offline mock
# openai -> always use OpenAI (or any OpenAI-compatible API via OPENAI_BASE_URL)
# mock   -> offline rule-based responses (for frontend development & tests)
LLM_PROVIDER=auto
OPENAI_API_KEY=your_key_here
# Optional: OpenAI-compatible endpoint (e.g. a local Ollama / vLLM server)
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
# Maximum answer length in tokens. Reasoning models (o-series, gpt-5*) count hidden
# reasoning here too, so they need a higher value (e.g. 4000).
LLM_MAX_TOKENS=600
# How LLM_MAX_TOKENS is sent: auto | max_completion_tokens | max_tokens
# auto -> max_completion_tokens for api.openai.com, max_tokens for OPENAI_BASE_URL servers.
# If the model rejects the choice, the backend switches automatically.
LLM_TOKEN_PARAM=auto
# Total time budget (seconds) for one answer, retries included. Capped at 40 so the
# backend always gives up before the frontend (REQUEST_TIMEOUT_MS = 45 s).
LLM_TIMEOUT_SECONDS=30
# Extra attempts for transient errors (timeout, connection, rate limit, 5xx): 0-3
LLM_MAX_RETRIES=1
# Rough prompt size limit in characters; the oldest history is dropped beyond it
LLM_MAX_INPUT_CHARS=24000

# ---- Chat behaviour ----
# Language used when auto-detection is inconclusive: ky | ru
DEFAULT_LANGUAGE=ky
# How many previous messages are sent to the LLM as context
HISTORY_LIMIT=10
